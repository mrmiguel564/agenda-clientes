# Copia este archivo como .env y ajusta los valores.

# Rubro (preset). v1: vet
VERTICAL=vet

APP_PORT=3000
PUBLIC_URL=http://localhost:3000

POSTGRES_DB=agenda
POSTGRES_USER=agenda
POSTGRES_PASSWORD=cambia-esta-clave

# Texto largo y aleatorio para firmar cookies
COOKIE_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Acceso al panel /admin
ADMIN_EMAIL=miguel.espinoza.dev@gmail.com
ADMIN_PASSWORD=cambia-esta-clave

# Código de verificación por correo antes de confirmar la hora (demo: apagado)
OTP_ENABLED=false

# --- Correo ---
# Desarrollo: Mailpit (incluido en docker compose). Ver correos en http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Huellitas Vet <miguel.espinoza.dev@gmail.com>"

# --- Publicar con Cloudflare Tunnel (docker compose --profile tunnel up -d) ---
# Token del túnel (Cloudflare Zero Trust → Networks → Tunnels → tu túnel → token)
CLOUDFLARE_TUNNEL_TOKEN=
# En producción, además:
#   PUBLIC_URL=https://agenda.tudominio.cl
#   TRUST_PROXY=1     (para que los límites por IP usen la IP real del visitante)

# Producción con Gmail (requiere verificación en 2 pasos + contraseña de aplicación):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=miguel.espinoza.dev@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
